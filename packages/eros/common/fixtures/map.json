    {
      "name": "should throw a new ValidationError with its pointers remapped and the input as cause when a validationMapper is set",
      "input": {
        "mapper": {
          "mode": "transparent",
          "validationMapper": {
            "prefixValidationFields": {
              "prefix": "#/outer"
            }
          }
        },
        "error": {
          "kind": "validation",
          "message": "Validation failed.",
          "details": {
            "errors": [
              {
                "pointer": "#/email",
                "code": "invalid-format",
                "detail": "must be an email"
              },
              {
                "pointer": "#/items/0/quantity",
                "code": "invalid-format",
                "detail": "must be a positive integer"
              }
            ]
          }
        }
      },
      "expected": {
        "throws": {
          "kind": "validation",
          "code": "validation",
          "details": {
            "errors": [
              {
                "pointer": "#/outer/email",
                "code": "invalid-format",
                "detail": "must be an email"
              },
              {
                "pointer": "#/outer/items/0/quantity",
                "code": "invalid-format",
                "detail": "must be a positive integer"
              }
            ]
          },
          "cause": "input"
        }
      }
    },
    {
      "name": "should remap a ValidationError when a validationMapper is set and the mode is unexpected",
      "input": {
        "mapper": {
          "mode": "unexpected",
          "validationMapper": {
            "createValidationMapper": [
              {
                "pattern": "#/email",
                "replacement": "#/contact/email"
              }
            ]
          }
        },
        "error": {
          "kind": "validation",
          "message": "Validation failed.",
          "details": {
            "errors": [
              {
                "pointer": "#/email",
                "code": "invalid-format",
                "detail": "must be an email"
              }
            ]
          }
        }
      },
      "expected": {
        "throws": {
          "kind": "validation",
          "code": "validation",
          "details": {
            "errors": [
              {
                "pointer": "#/contact/email",
                "code": "invalid-format",
                "detail": "must be an email"
              }
            ]
          },
          "cause": "input"
        }
      }
    },
    {
      "name": "should remap a ValidationError rather than map it when a validationMapper and a mapping both apply",
      "input": {
        "mapper": {
          "mode": "expected",
          "mappings": [
            {
              "source": {
                "kind": "validation"
              },
              "target": {
                "kind": "conflict",
                "class": "TargetConflictError",
                "meta": {
                  "module": "target",
                  "entity": "item"
                }
              }
            }
          ],
          "validationMapper": {
            "prefixValidationFields": {
              "prefix": "#/outer"
            }
          }
        },
        "error": {
          "kind": "validation",
          "message": "Validation failed.",
          "details": {
            "errors": [
              {
                "pointer": "#/email",
                "code": "invalid-format",
                "detail": "must be an email"
              }
            ]
          }
        }
