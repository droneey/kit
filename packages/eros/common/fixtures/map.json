      "expected": {
        "throws": {
          "kind": "validation",
          "code": "validation",
          "details": {
            "errors": [
              {
                "pointer": "#/outer/email",
                "code": "invalid-format",
                "detail": "must be an email"
              }
            ]
          },
          "cause": "input"
        }
      }
    },
