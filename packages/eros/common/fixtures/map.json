    {
      "name": "should throw the target with the input as cause when a mapping's source matches",
      "input": {
        "mapper": {
          "mode": "expected",
          "mappings": [
            {
              "source": {
                "kind": "not-found",
                "class": "SourceNotFoundError",
                "meta": {
                  "module": "source",
                  "entity": "item"
                }
              },
              "target": {
                "kind": "not-found",
                "class": "TargetNotFoundError",
                "meta": {
                  "module": "target",
                  "entity": "item"
                }
              }
            }
          ]
        },
        "error": {
          "kind": "not-found",
          "class": "SourceNotFoundError",
          "meta": {
            "module": "source",
            "entity": "item"
          },
          "message": "Source not found."
        }
      },
      "expected": {
        "throws": {
          "kind": "not-found",
          "class": "TargetNotFoundError",
          "code": "target/item/not-found",
          "cause": "input"
        }
      }
    },
    {
      "name": "should throw the first mapping's target when two mappings match",
      "input": {
        "mapper": {
          "mode": "expected",
          "mappings": [
            {
              "source": {
                "kind": "not-found",
