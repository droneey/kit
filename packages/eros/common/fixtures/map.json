{
  "operation": "map",
  "description": "createErrorMapper: what the mapper throws for each mode and each kind of input, with mappings and a validationMapper. It rethrows the input itself, or throws a new error whose cause is the input.",
  "cases": [
    {
      "name": "should wrap the value in an UnexpectedError when the mode is transparent and the value is not an error",
      "input": {
        "mapper": {
          "mode": "transparent"
        },
        "error": {
          "thrown": "boom"
        }
      },
      "expected": {
        "throws": {
          "kind": "internal",
          "code": "internal",
          "cause": "input"
        }
      }
    },
    {
      "name": "should rethrow the input when the mode is transparent and the input is unexpected",
      "input": {
        "mapper": {
          "mode": "transparent"
        },
        "error": {
          "kind": "internal",
          "message": "Order 42 has no items."
        }
      },
      "expected": {
        "throws": "input"
      }
    },
    {
      "name": "should rethrow the input when the mode is transparent and the input is a ValidationError",
      "input": {
        "mapper": {
          "mode": "transparent"
        },
        "error": {
          "kind": "validation",
          "message": "Validation failed.",
          "details": {
            "errors": [
              {
                "pointer": "#/email",
                "code": "required",
                "detail": "is required"
              }
            ]
          }
        }
      },
      "expected": {
        "throws": "input"
      }
    },
    {
      "name": "should rethrow the input when the mode is transparent and the input is expected",
      "input": {
        "mapper": {
          "mode": "transparent"
        },
        "error": {
          "kind": "not-found",
          "class": "SourceNotFoundError",
          "meta": {
            "module": "source",
            "entity": "item"
          },
          "message": "Source not found."
        }
      },
      "expected": {
        "throws": "input"
      }
    },
    {
      "name": "should rethrow the input when the mode is transparent and the input is not of eros",
      "input": {
        "mapper": {
          "mode": "transparent"
        },
        "error": {
          "foreign": {
            "name": "Error",
            "message": "Connection failed."
          }
        }
      },
      "expected": {
        "throws": "input"
      }
    },
