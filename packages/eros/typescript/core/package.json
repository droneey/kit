{
  "name": "@droneey/eros",
  "version": "0.0.0",
  "private": false,
  "description": "Expected and unexpected errors as a problem response, a log record and back, for any JavaScript runtime.",
  "homepage": "https://github.com/droneey/kit/tree/main/packages/eros/typescript/core#readme",
  "bugs": {
    "url": "https://github.com/droneey/kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Dmytro Kurovskyi",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/kit.git",
    "directory": "packages/eros/typescript/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/__tests__"
  ],
  "scripts": {
    "type:check": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "architecture:check": "depcruise src --config ../../../../.dependency-cruiser.mjs"
  }
}
