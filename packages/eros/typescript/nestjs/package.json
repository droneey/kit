{
  "name": "@droneey/eros-nestjs",
  "version": "0.0.0",
  "private": false,
  "description": "eros for NestJS: the exception filter, interceptors, DTO validation and OpenAPI helpers.",
  "homepage": "https://github.com/droneey/kit/tree/main/packages/eros/typescript/nestjs#readme",
  "bugs": {
    "url": "https://github.com/droneey/kit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Dmytro Kurovskyi",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/kit.git",
    "directory": "packages/eros/typescript/nestjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/__tests__"
  ],
  "scripts": {
    "type:check": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "architecture:check": "depcruise src --config ../../../../.dependency-cruiser.mjs"
  },
  "devDependencies": {
    "@droneey/eros": "workspace:*",
    "@droneey/eros-wire": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "light-my-request": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@droneey/eros": ">=0.0.0",
    "@droneey/eros-wire": ">=0.0.0",
    "@nestjs/common": ">=11.0.0",
    "@nestjs/core": ">=11.0.0",
    "@nestjs/swagger": ">=11.0.0",
    "class-transformer": ">=0.5.1",
    "class-validator": ">=0.14.0",
    "reflect-metadata": ">=0.2.0",
    "rxjs": ">=7.8.0"
  }
}
